<div class="tk-stats">
  {{#if missing}}
    <section class="tk-stats-empty">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <h2>{{sessionName}}</h2>
    </section>
  {{else}}
    <header class="tk-stats-header">
      <div>
        <div class="tk-stats-eyebrow">
          {{#if active}}Aktiv session{{else}}Avslutad session{{/if}}
        </div>
        <h1>{{sessionName}}</h1>
        <p>
          {{startedAt}}
          {{#if endedAt}} · avslutad {{endedAt}}{{/if}}
          {{#if duration}} · {{duration}}{{/if}}
        </p>
      </div>
    </header>

    <section class="tk-stat-grid">
      <article class="tk-stat-card">
        <span>Registrerade slag</span>
        <strong>{{total}}</strong>
      </article>

      <article class="tk-stat-card">
        <span>Lyckade</span>
        <strong>{{successes}}</strong>
        <small>{{successRate}} %</small>
      </article>

      <article class="tk-stat-card">
        <span>Misslyckade</span>
        <strong>{{failures}}</strong>
      </article>

      <article class="tk-stat-card tk-stat-dragon">
        <span>Drakar</span>
        <strong>{{dragons}}</strong>
      </article>

      <article class="tk-stat-card tk-stat-demon">
        <span>Demoner</span>
        <strong>{{demons}}</strong>
      </article>

      <article class="tk-stat-card">
        <span>Pushade slag</span>
        <strong>{{pushed}}</strong>
      </article>

      <article class="tk-stat-card">
        <span>Slag med Boon</span>
        <strong>{{boonRolls}}</strong>
      </article>

      <article class="tk-stat-card">
        <span>Slag med Bane</span>
        <strong>{{baneRolls}}</strong>
      </article>
    </section>

    {{#if highlights.length}}
      <section class="tk-chronicle">
        <div class="tk-section-heading">
          <div>
            <div class="tk-stats-eyebrow">Ur kvällens krönika</div>
            <h2>Höjdpunkter</h2>
          </div>
        </div>

        <div class="tk-highlight-grid">
          {{#each highlights}}
            <article class="tk-highlight-card">
              <i class="{{icon}}" aria-hidden="true"></i>
              <span>{{title}}</span>
              <strong>{{primary}}</strong>
              <small>{{detail}}</small>
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}

    <section class="tk-stats-section">
      <div class="tk-section-heading">
        <div>
          <h2>d20-fördelning</h2>
          <p>Visar det resultat som faktiskt räknades. Bortkastade Boon/Bane-tärningar ingår inte.</p>
        </div>
      </div>

      <div class="tk-d20-chart" role="img" aria-label="Fördelning av d20-resultat från 1 till 20">
        {{#each distribution}}
          <div class="tk-d20-column">
            <div class="tk-d20-count">{{count}}</div>
            <div class="tk-d20-bar-track">
              <div class="tk-d20-bar-fill" style="height: {{heightPercent}}%;"></div>
            </div>
            <div class="tk-d20-label">{{value}}</div>
          </div>
        {{/each}}
      </div>
    </section>

    <section class="tk-discord-section">
      <div class="tk-section-heading">
        <div>
          <div class="tk-stats-eyebrow">Publicera krönikan</div>
          <h2>Discord</h2>
          <p>
            {{#if discordConfigured}}
              En webhook är konfigurerad för din GM-användare.
            {{else}}
              Ingen Discord-webhook är konfigurerad ännu.
            {{/if}}
          </p>
        </div>
      </div>

      <div class="tk-discord-actions">
        <button type="button" data-action="configure-discord" class="tk-secondary">
          <i class="fa-solid fa-gear"></i>
          {{#if discordConfigured}}Ändra webhook{{else}}Konfigurera Discord{{/if}}
        </button>

        <button
          type="button"
          data-action="send-discord"
          data-session-id="{{sessionId}}"
          class="tk-primary tk-discord-send"
        >
          <i class="fa-brands fa-discord"></i>
          Skicka till Discord
        </button>
      </div>

      <p class="tk-discord-note">
        Rapporten skickas först när du trycker på knappen. Ingen automatisk publicering sker.
      </p>
    </section>

    {{#if actors.length}}
      <section class="tk-stats-section">
        <div class="tk-section-heading">
          <div>
            <h2>Rollpersoner & tester</h2>
            <p>Färdigheter och egenskapsslag samlas per rollperson. Rollpersonerna identifieras internt med actorUuid.</p>
          </div>
        </div>

        <div class="tk-character-list">
          {{#each actors}}
            <details class="tk-character-card" open>
              <summary>
                <div class="tk-character-name">
                  <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                  <strong>{{name}}</strong>
                </div>

                <div class="tk-character-summary">
                  <span><b>{{rolls}}</b> slag</span>
                  <span><b>{{successRate}} %</b> lyckade</span>
                  <span><b>{{dragons}}</b> drakar</span>
                  <span><b>{{demons}}</b> demoner</span>
                  <span><b>{{pushes}}</b> pushar</span>
                </div>
              </summary>

              <div class="tk-skill-table">
                <div class="tk-skill-row tk-skill-header">
                  <span>Test</span>
                  <span>Slag</span>
                  <span>Lyckade</span>
                  <span>%</span>
                  <span>Drake</span>
                  <span>Demon</span>
                  <span>Push</span>
                </div>

                {{#each skills}}
                  <div class="tk-skill-row">
                    <strong>{{name}}</strong>
                    <span>{{rolls}}</span>
                    <span>{{successes}}</span>
                    <span>{{successRate}}</span>
                    <span>{{dragons}}</span>
                    <span>{{demons}}</span>
                    <span>{{pushes}}</span>
                  </div>
                {{/each}}
              </div>
            </details>
          {{/each}}
        </div>
      </section>
    {{/if}}
  {{/if}}
</div>
